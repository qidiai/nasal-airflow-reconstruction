FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    location    "0";
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //


dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    inletL
    {
        type            flowRateInletVelocity;
        volumetricFlowRate 9.750341e-05;
        value           uniform (0 0 0);
    }
    inletR
    {
        type            flowRateInletVelocity;
        volumetricFlowRate 1.524966e-04;
        value           uniform (0 0 0);
    }
    outlet
    {
        type            zeroGradient;
    }
    walls
    {
        type            fixedValue;
        value           uniform (0 0 0);
    }
}

